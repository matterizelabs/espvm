#!/bin/bash
# espvm - ESP SDK Version Manager

# ── Logging ──

_espvm_info()   { printf '\033[0;34m%s\033[0m\n' "$*"; }
_espvm_info_n() { printf '\033[0;34m%s\033[0m' "$*"; }
_espvm_ok()     { printf '\033[0;32m%s\033[0m\n' "$*"; }
_espvm_warn()   { printf '\033[0;33m%s\033[0m\n' "$*" >&2; }
_espvm_error()  { printf '\033[0;31m%s\033[0m\n' "$*" >&2; }

# ── Config ──

_espvm_validate_config_dir() {
    local dir="${ESPVM_CONFIG_DIR:-$HOME/.espressif/.espvm}"
    [[ "$dir" != /* ]] && { _espvm_error "Error: ESPVM_CONFIG_DIR must be absolute: $dir"; return 1; }
    [[ "$dir" == */../* || "$dir" == */.. ]] && \
        { _espvm_error "Error: ESPVM_CONFIG_DIR contains path traversal: $dir"; return 1; }
    [[ -d "$dir" ]] && dir="$(cd "$dir" 2>/dev/null && pwd -P)" || true
    case "$dir" in
        "$HOME"|"$HOME"/*|/etc/espvm|/etc/espvm/*|/opt/espvm|/opt/espvm/*) ;;
        *) _espvm_warn "Warning: ESPVM_CONFIG_DIR is outside \$HOME, /etc/espvm, /opt/espvm: $dir" ;;
    esac
    echo "$dir"
}

ESPVM_CONFIG_DIR="$(_espvm_validate_config_dir)" || ESPVM_CONFIG_DIR="$HOME/.espressif/.espvm"
ESPVM_CONFIG_FILE="$ESPVM_CONFIG_DIR/config"
_ESPVM_VERBOSE=0

# ── SDK Definitions ──

declare -A _ESPVM_SDKS=([idf]="esp-idf" [matter]="esp-matter")
declare -A _ESPVM_SDK_REPOS=([idf]="espressif/esp-idf" [matter]="espressif/esp-matter")
declare -A _ESPVM_SDK_ENV_VAR=([idf]="IDF_PATH" [matter]="ESP_MATTER_PATH")
declare -A _ESPVM_SDK_INSTALL_ARGS=([idf]="" [matter]="--no-host-tool")
declare -A _ESPVM_SDK_USE_WORKTREE=([idf]=1 [matter]=0)
declare -A _ESPVM_SDK_REQUIRES=([idf]="" [matter]="idf")

# ── Output & Prompts ──

_espvm_prompt() {
    local prompt="$1" default="${2:-}" reply=""
    if [[ -n "$default" ]]; then
        echo -n "$prompt [$default]: " >&2
    else
        echo -n "$prompt" >&2
    fi
    IFS= read -r reply || true
    [[ -z "$reply" && -n "$default" ]] && reply="$default"
    echo "$reply"
}

_espvm_confirm() {
    local answer
    echo -n "$1 [y/N]: " >&2
    IFS= read -r answer || true
    [[ "$answer" =~ ^[Yy]$ ]]
}

# ── Security & Validation ──

_espvm_realpath() {
    local p="$1"
    if command -v realpath &>/dev/null; then realpath -m "$p" 2>/dev/null || echo "$p"
    elif command -v readlink &>/dev/null; then readlink -f "$p" 2>/dev/null || echo "$p"
    else (cd "$p" 2>/dev/null && pwd -P) 2>/dev/null || echo "$p"
    fi
}

_espvm_is_system_path() {
    local p="$1"
    [[ "$p" == / || "$p" == /usr/* || "$p" == /etc/* || "$p" == /var/* || \
       "$p" == /proc/* || "$p" == /sys/* || "$p" == /boot/* || "$p" == /dev/* ]]
}

_espvm_verify_signed_tag() {
    local repo_dir="$1" version="$2"
    if git -C "$repo_dir" tag -v "$version" &>/dev/null; then
        _espvm_ok "Tag signature verified for $version"
        return 0
    fi
    if [[ "${ESPVM_STRICT_SIGNED_TAGS:-0}" == "1" ]]; then
        _espvm_error "Error: Tag $version is not signed or signature could not be verified (ESPVM_STRICT_SIGNED_TAGS=1)"
        return 1
    fi
    _espvm_warn "Warning: Tag $version is not signed or signature could not be verified"
    _espvm_confirm "Continue with unsigned tag?" || { _espvm_error "Aborting"; return 1; }
    return 0
}

_espvm_safe_rm_rf() {
    local target="$1" wt="$(_espvm_get_worktree_dir)"
    [[ -z "$target" || "$target" == "/" ]] && { _espvm_error "Error: Refusing to remove: $target"; return 1; }
    local real_target real_wt real_config
    real_target="$(_espvm_realpath "$target")"
    real_wt="$(_espvm_realpath "$wt")"
    real_config="$(_espvm_realpath "$ESPVM_CONFIG_DIR")"
    [[ -z "$real_target" || "$real_target" == "/" ]] && { _espvm_error "Error: Refusing to remove: $target"; return 1; }
    [[ "$real_target" == "$real_wt"/* || "$real_target" == "$real_config"/* ]] && { rm -rf "$target"; return $?; }
    _espvm_error "Error: Refusing to remove directory outside safe locations: $target"; return 1
}

_espvm_validate_version() {
    local version="$1"
    [[ -z "$version" ]] && { _espvm_error "Error: Version cannot be empty"; return 1; }
    [[ "$version" == -* ]] && { _espvm_error "Error: Version cannot start with '-': $version"; return 1; }
    [[ "$version" == "." || "$version" == ".." || "$version" == */. || "$version" == */.. || "$version" == ./* || "$version" == ../* ]] && \
        { _espvm_error "Error: Version contains path traversal component: $version"; return 1; }
    [[ ! "$version" =~ ^[a-zA-Z0-9._/-]+$ ]] && { _espvm_error "Error: Invalid characters in version: $version"; return 1; }
    return 0
}

_espvm_validate_config_value() {
    local val="$1"
    [[ "$val" =~ [\`\$\;\|\&] ]] && { _espvm_error "Error: Config value contains disallowed characters: $1"; return 1; }
    return 0
}

_espvm_enforce_secure_git() {
    local gitconfig="$ESPVM_CONFIG_DIR/git-secure.config"
    if [[ ! -f "$gitconfig" ]]; then
        mkdir -p "$ESPVM_CONFIG_DIR"
        git config -f "$gitconfig" url."https://".insteadOf "git://" 2>/dev/null
        git config -f "$gitconfig" protocol.file.allow never 2>/dev/null
        git config -f "$gitconfig" protocol.ext.allow never 2>/dev/null
    fi
    export GIT_CONFIG_GLOBAL="$gitconfig"
}

_espvm_sha256() {
    local file="$1"
    if command -v sha256sum &>/dev/null; then sha256sum "$file" | cut -d' ' -f1
    elif command -v shasum &>/dev/null; then shasum -a 256 "$file" | cut -d' ' -f1
    elif command -v openssl &>/dev/null; then openssl dgst -sha256 "$file" | awk '{print $NF}'
    else echo ""
    fi
}

_espvm_verify_script_hash() {
    local script="$1" label="$2"
    local script_dir; script_dir="$(cd "$(dirname "$script")" && pwd)"
    # Store hashes in config dir (not alongside scripts) so an attacker who
    # controls the version directory cannot also control the expected hash.
    local safe_name="${script_dir//\//_}"
    local hash_dir="$ESPVM_CONFIG_DIR/hashes"
    mkdir -p "$hash_dir"
    local hash_file="$hash_dir/.espvm-${safe_name}-${label}.sha256"
    local current_hash; current_hash="$(_espvm_sha256 "$script")"

    if [[ -z "$current_hash" ]]; then
        _espvm_warn "Warning: Cannot compute SHA-256 for $script"; return 0
    fi
    if [[ -f "$hash_file" ]]; then
        local recorded_hash; recorded_hash="$(cat "$hash_file")"
        if [[ "$current_hash" != "$recorded_hash" ]]; then
            _espvm_warn "Warning: $label has changed since last activation!"
            _espvm_warn "  Previous: $recorded_hash"
            _espvm_warn "  Current:  $current_hash"
            _espvm_confirm "Continue?" || return 1
            echo "$current_hash" > "$hash_file"
        fi
    else
        _espvm_warn "First run: $label has no recorded hash ($current_hash)"
        _espvm_confirm "Trust this hash?" || return 1
        echo "$current_hash" > "$hash_file"
    fi
    return 0
}

_espvm_verify_version_origin() {
    local version_dir="$1"
    if [[ ! -e "$version_dir/.git" ]]; then
        _espvm_error "Error: $version_dir is not a git repository — refusing to source"
        return 1
    fi
    if ! git -C "$version_dir" diff --quiet HEAD; then
        _espvm_warn "Warning: $version_dir has local modifications."
        _espvm_confirm "Continue sourcing?" || return 1
    fi
    local current_ref; current_ref="$(git -C "$version_dir" rev-parse --abbrev-ref HEAD)"
    if [[ "$current_ref" == "HEAD" ]]; then
        local head_commit; head_commit="$(git -C "$version_dir" rev-parse HEAD)"
        if ! git -C "$version_dir" branch -r --contains "$head_commit" 2>/dev/null | grep -q "." \
           && ! git -C "$version_dir" tag --contains "$head_commit" 2>/dev/null | grep -q "."; then
            _espvm_warn "Warning: HEAD commit not found on any remote branch or tag."
            _espvm_confirm "Continue?" || return 1
        fi
    fi
    return 0
}

_espvm_verify_install_integrity() {
    [[ ! -e "$1/.git" ]] && { _espvm_error "Error: $1 is not a git repository"; return 1; }
    git -C "$1" diff --quiet -- install.sh && \
    git -C "$1" diff --quiet HEAD -- install.sh
}

_espvm_verify_python_script() {
    local script_path="$1"
    local script_dir; script_dir="$(cd "$(dirname "$script_path")" && pwd)"
    local script_name; script_name="$(basename "$script_path")"
    [[ ! -e "$script_dir/.git" ]] && { _espvm_error "Error: $script_dir is not a git repository"; return 1; }
    git -C "$script_dir" diff --quiet -- "$script_name" && \
    git -C "$script_dir" diff --quiet HEAD -- "$script_name"
}

_espvm_check_prereqs() {
    command -v git &>/dev/null || { _espvm_error "Error: git is not installed"; return 1; }
    command -v python3 &>/dev/null || { _espvm_error "Error: python3 is not installed"; return 1; }
    _espvm_enforce_secure_git
}

# ── Config Management ──

_espvm_load_config() {
    ESPVM_WORKTREE_DIR=""
    ESPVM_USE_SSH="auto"
    [[ ! -f "$ESPVM_CONFIG_FILE" ]] && return 0
    local key value line
    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ "$line" =~ ^[[:space:]]*# ]] && continue
        [[ -z "${line// /}" ]] && continue
        if [[ "$line" =~ ^[A-Za-z_][A-Za-z0-9_]*= ]]; then
            key="${line%%=*}"; value="${line#*=}"
            value="${value#\"}"; value="${value%\"}"
            value="${value#\'}"; value="${value%\'}"
            _espvm_validate_config_value "$value" || continue
            case "$key" in
                ESPVM_WORKTREE_DIR) ESPVM_WORKTREE_DIR="$value" ;;
                ESPVM_USE_SSH) ESPVM_USE_SSH="$value" ;;
            esac
        fi
    done < "$ESPVM_CONFIG_FILE"
}

_espvm_save_config() {
    mkdir -p "$ESPVM_CONFIG_DIR"
    printf 'ESPVM_WORKTREE_DIR="%s"\nESPVM_USE_SSH="%s"\n' \
        "$ESPVM_WORKTREE_DIR" "$ESPVM_USE_SSH" > "$ESPVM_CONFIG_FILE"
}

# ── Path & Version Helpers ──

_espvm_get_active_path() {
    local sdk="$1"
    local env_var="${_ESPVM_SDK_ENV_VAR[$sdk]}"
    case "$env_var" in
        IDF_PATH|ESP_MATTER_PATH) ;;
        *) _espvm_error "Error: Unknown SDK env var: $env_var"; return 1 ;;
    esac
    if [[ -n "${ZSH_VERSION:-}" ]]; then echo "${(P)env_var}"
    else echo "${!env_var}"
    fi
}

_espvm_is_active() { [[ -n "$(_espvm_get_active_path "$1")" ]]; }
_espvm_uses_worktree() { [[ "${_ESPVM_SDK_USE_WORKTREE[$1]}" == "1" ]]; }
_espvm_normalize_version() { if [[ "$1" =~ ^[0-9] ]]; then echo "v$1"; else echo "$1"; fi; }
_espvm_resolve_version() { _espvm_validate_version "$1" || return 1; _espvm_normalize_version "$1"; }
_espvm_encode_version() { echo "${1//\//-}"; }
_espvm_decode_version() { if [[ "$1" == release-* ]]; then echo "${1/release-/release\/}"; else echo "$1"; fi; }
_espvm_get_bare_dir() { echo "$ESPVM_CONFIG_DIR/${_ESPVM_SDKS[$1]}.bare"; }
_espvm_get_sdk_dir() { echo "$(_espvm_get_worktree_dir)/${_ESPVM_SDKS[$1]}"; }
_espvm_get_current_file() { echo "$(_espvm_get_sdk_dir "$1")/.current"; }

_espvm_get_worktree_dir() {
    _espvm_load_config
    [[ -n "$ESPVM_WORKTREE_DIR" ]] && { echo "$ESPVM_WORKTREE_DIR"; return; }
    echo "" >&2; _espvm_info "First-time setup: Where to store ESP SDK versions?" >&2
    echo "  [1] ~/.espressif/versions (default)" >&2
    echo "  [2] Custom path" >&2; echo "" >&2
    local choice; choice="$(_espvm_prompt "Choice" "1")"
    case "$choice" in
        2)
            local custom_path; custom_path="$(_espvm_prompt "Enter path:")"
            custom_path="${custom_path/#\~/$HOME}"
            [[ "$custom_path" == /* ]] || custom_path="$(cd "$custom_path" 2>/dev/null && pwd -P)" || {
                _espvm_error "Error: Invalid path: $custom_path" >&2; return 1
            }
            if _espvm_is_system_path "$custom_path"; then
                _espvm_error "Error: Cannot set worktree-dir to system path: $custom_path" >&2; return 1
            fi
            ESPVM_WORKTREE_DIR="$custom_path" ;;
        *) ESPVM_WORKTREE_DIR="$HOME/.espressif/versions" ;;
    esac
    _espvm_save_config
    _espvm_ok "Configuration saved to $ESPVM_CONFIG_FILE" >&2
    echo "" >&2
    echo "$ESPVM_WORKTREE_DIR"
}

# ── SSH & Repository ──

_ESPVM_SSH_CHECK_RESULT="" _ESPVM_SSH_CHECK_TIME=0 _ESPVM_SSH_CACHE_TTL=300

_espvm_check_ssh() {
    local now; now="$(date +%s 2>/dev/null || echo 0)"
    if [[ -n "$_ESPVM_SSH_CHECK_RESULT" && $((now - _ESPVM_SSH_CHECK_TIME)) -lt $_ESPVM_SSH_CACHE_TTL ]]; then
        [[ "$_ESPVM_SSH_CHECK_RESULT" == "yes" ]]; return $?
    fi
    if ssh -o BatchMode=yes -o ConnectTimeout=5 -T git@github.com 2>/dev/null | grep -q "successfully authenticated"; then
        _ESPVM_SSH_CHECK_RESULT="yes"
    else
        _ESPVM_SSH_CHECK_RESULT="no"
    fi
    _ESPVM_SSH_CHECK_TIME="$now"
    [[ "$_ESPVM_SSH_CHECK_RESULT" == "yes" ]]
}

_espvm_get_repo_url() {
    local sdk="$1"
    local sdk_repo="${_ESPVM_SDK_REPOS[$sdk]}"
    _espvm_load_config
    local use_ssh="${ESPVM_USE_SSH:-auto}"
    if [[ "$use_ssh" == "auto" ]]; then
        _espvm_check_ssh && use_ssh="yes" || use_ssh="no"
    fi
    if [[ "$use_ssh" == "yes" ]]; then echo "git@github.com:${sdk_repo}.git"
    else echo "https://github.com/${sdk_repo}.git"
    fi
}

_espvm_warn_insecure_url() {
    local url="$1"
    [[ "$url" != https://* && "$url" != git@* && "$url" != ssh://* ]] && \
        _espvm_warn "Warning: Repository URL doesn't use HTTPS or SSH: $url"
}

# ── Quiet Execution ──

_espvm_run_quiet() {
    local tmpfile; tmpfile="$(mktemp "${TMPDIR:-/tmp}/espvm.XXXXXX")" || return 1
    chmod 600 "$tmpfile"
    if [[ $_ESPVM_VERBOSE -eq 1 ]]; then
        "$@"; local ret=$?; rm -f "$tmpfile"; return $ret
    else
        "$@" > "$tmpfile" 2>&1; local ret=$?
        [[ $ret -ne 0 ]] && cat "$tmpfile"
        rm -f "$tmpfile"; return $ret
    fi
}

_espvm_source_quiet() {
    local script="$1" sdk="$2"
    local script_dir; script_dir="$(cd "$(dirname "$script")" && pwd)"
    if [[ -n "$sdk" ]] && ! _espvm_verify_version_origin "$script_dir" "$sdk"; then
        _espvm_confirm "Continue sourcing $script?" || return 1
    fi
    _espvm_verify_script_hash "$script" "export.sh" || return 1
    local tmpfile; tmpfile="$(mktemp "${TMPDIR:-/tmp}/espvm.XXXXXX")" || return 1
    chmod 600 "$tmpfile"
    if [[ $_ESPVM_VERBOSE -eq 1 ]]; then
        source "$script"; local ret=$?; rm -f "$tmpfile"; return $ret
    else
        source "$script" > "$tmpfile" 2>&1; local ret=$?
        if grep -qE "(FAILED|ERROR:)" "$tmpfile"; then
            cat "$tmpfile"; rm -f "$tmpfile"; return 1
        fi
        rm -f "$tmpfile"; return $ret
    fi
}

_espvm_run_python_script() {
    local script_path="$1"; shift
    [[ ! -f "$script_path" ]] && { _espvm_error "Error: Script not found: $script_path"; return 1; }
    if ! _espvm_verify_python_script "$script_path"; then
        _espvm_warn "Warning: $script_path has local modifications."
        _espvm_confirm "Run this script anyway?" || return 1
    fi
    local script_name; script_name="$(basename "$script_path")"
    _espvm_verify_script_hash "$script_path" "python-${script_name}" || return 1
    python3 "$script_path" "$@"
}

# ── Git Operations ──

_espvm_init_bare() {
    local sdk="$1"
    local bare_dir="$(_espvm_get_bare_dir "$sdk")"
    local repo_url="$(_espvm_get_repo_url "$sdk")" sdk_name="${_ESPVM_SDKS[$sdk]}"
    if [[ ! -d "$bare_dir" ]]; then
        _espvm_info "Initializing $sdk_name repository..."
        mkdir -p "$(dirname "$bare_dir")"
        _espvm_warn_insecure_url "$repo_url"
        git clone --bare "$repo_url" "$bare_dir" || { _espvm_error "Error: Failed to clone $sdk_name"; return 1; }
        git -C "$bare_dir" config remote.origin.fetch "+refs/heads/*:refs/remotes/origin/*"
        _espvm_ok "Repository initialized"
    fi
    return 0
}

_espvm_ensure_bare() {
    local sdk="$1"
    local bare_dir="$(_espvm_get_bare_dir "$sdk")"
    if [[ ! -d "$bare_dir" ]]; then
        _espvm_warn "Bare repository missing, reinitializing..."
        _espvm_init_bare "$sdk" || return 1
        _espvm_repair_worktrees "$sdk"
    fi
}

_espvm_repair_worktrees() {
    local sdk="$1"
    local bare_dir="$(_espvm_get_bare_dir "$sdk")" sdk_dir="$(_espvm_get_sdk_dir "$sdk")"
    [[ ! -d "$bare_dir" || ! -d "$sdk_dir" ]] && return 0
    for dir in "$sdk_dir"/*/; do
        [[ ! -d "$dir" ]] && continue
        local wt_name; wt_name="$(basename "$dir")"
        local wt_git_dir="$bare_dir/worktrees/$wt_name"
        [[ ! -d "$wt_git_dir" ]] && { mkdir -p "$wt_git_dir"; echo "$dir" > "$wt_git_dir/gitdir"; }
        local head_ref; head_ref="$(git -C "$dir" rev-parse HEAD 2>/dev/null)"
        [[ -n "$head_ref" ]] && echo "$head_ref" > "$wt_git_dir/HEAD"
        [[ -f "$dir.git" ]] && echo "gitdir: $wt_git_dir" > "$dir.git"
    done
    git -C "$bare_dir" worktree repair "$sdk_dir" 2>/dev/null
}

# ── Environment Management ──

_espvm_path_remove() {
    local remove="$1" new_path="" IFS=':' entry
    local -a entries
    if [[ -n "${ZSH_VERSION:-}" ]]; then
        entries=("${(s/:/)PATH}")
    else
        read -ra entries <<< "$PATH"
    fi
    for entry in "${entries[@]}"; do
        [[ "$entry" != "$remove" && "$entry" != "$remove"/* ]] && new_path="${new_path:+$new_path:}$entry"
    done
    echo "$new_path"
}

_espvm_clear_sdk_env() {
    local sdk="$1"
    local active_path="$(_espvm_get_active_path "$sdk")"
    [[ -n "$active_path" ]] && PATH="$(_espvm_path_remove "$active_path")"
    if [[ "$sdk" == "idf" ]]; then
        [[ -n "$IDF_TOOLS_PATH" ]] && PATH="$(_espvm_path_remove "$IDF_TOOLS_PATH")"
        unset IDF_PATH IDF_PYTHON_ENV_PATH IDF_TOOLS_PATH IDF_COMPONENT_MANAGER_URL
        unset OPENOCD_SCRIPTS ESP_IDF_VERSION ESP_ROM_ELF_DIR ESP_MATTER_PATH
    else
        unset ESP_MATTER_PATH
    fi
}

_espvm_check_sdk_deps() {
    local sdk="$1"
    local requires="${_ESPVM_SDK_REQUIRES[$sdk]}"
    if [[ -n "$requires" ]] && ! _espvm_is_active "$requires"; then
        _espvm_error "Error: ${_ESPVM_SDKS[$sdk]} requires ${_ESPVM_SDKS[$requires]} to be active. Run 'espvm use <version>' first"
        return 1
    fi
    return 0
}

_espvm_off() {
    local sdk="$1" sdk_name="${_ESPVM_SDKS[$sdk]}"
    if ! _espvm_is_active "$sdk"; then
        _espvm_warn "$sdk_name is not active"
        return 0
    fi
    _espvm_clear_sdk_env "$sdk"
    local current_file="$(_espvm_get_current_file "$sdk")"
    rm -f "$current_file"
    _espvm_ok "$sdk_name deactivated"
}

# ── Install ──

_espvm_check_tools() {
    [[ ! -f "$1/tools/idf_tools.py" ]] && return 1
    IDF_PATH="$1" python3 "$1/tools/idf_tools.py" check >/dev/null 2>&1
}

_espvm_run_install() {
    local version_dir="$1" sdk="$2"
    if ! _espvm_verify_install_integrity "$version_dir"; then
        _espvm_warn "Warning: install.sh has local modifications."
        _espvm_confirm "Run install.sh anyway?" || return 1
    fi
    _espvm_verify_script_hash "$version_dir/install.sh" "install.sh" || return 1
    local install_args="${_ESPVM_SDK_INSTALL_ARGS[$sdk]}"
    if [[ -n "$install_args" ]]; then
        (cd "$version_dir" && _espvm_run_quiet ./install.sh "$install_args")
    else
        (cd "$version_dir" && _espvm_run_quiet ./install.sh)
    fi
}

_espvm_maybe_install() {
    local version_dir="$1" version="$2" sdk="$3" force="${4:-0}"
    [[ ! -f "$version_dir/install.sh" ]] && { _espvm_warn "No install.sh found, skipping tools installation"; return 0; }
    if [[ "$sdk" == "idf" && "$force" -ne 1 ]] && _espvm_check_tools "$version_dir"; then
        _espvm_ok "Tools already installed for $version"; return 0
    fi
    _espvm_info_n "Installing tools for $version... "
    if _espvm_run_install "$version_dir" "$sdk"; then
        _espvm_ok "done"; return 0
    else
        _espvm_error "failed"; return 1
    fi
}

_espvm_install() {
    local sdk="$1" version="$2"; shift 2
    local force=0 install_path=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --path=*) install_path="${1#*=}"; install_path="${install_path/#\~/$HOME}"; shift ;;
            --path)   install_path="$2"; install_path="${install_path/#\~/$HOME}"; shift 2 ;;
            --force|-f) force=1; shift ;;
            --verbose|-v) _ESPVM_VERBOSE=1; shift ;;
            *) _espvm_error "Unknown option: $1"; return 1 ;;
        esac
    done

    [[ -z "$version" ]] && { _espvm_error "Usage: espvm $sdk install <version> [--path=<dir>] [--force]"; return 1; }
    _espvm_check_prereqs || return 1

    local sdk_name="${_ESPVM_SDKS[$sdk]}"
    version="$(_espvm_resolve_version "$version")" || return 1
    local encoded_version="$(_espvm_encode_version "$version")"
    local sdk_dir="${install_path:-$(_espvm_get_sdk_dir "$sdk")}"
    [[ -n "$install_path" ]] && sdk_dir="$install_path/${_ESPVM_SDKS[$sdk]}"
    local version_dir="$sdk_dir/$encoded_version"

    if [[ -d "$version_dir" ]]; then
        if [[ $force -eq 1 ]]; then
            _espvm_warn "Reinstalling tools for $sdk_name $version..."
            _espvm_maybe_install "$version_dir" "$version" "$sdk" 1 || return 1
            _espvm_ok "Tools reinstalled"; return 0
        fi
        _espvm_warn "$sdk_name $version is already installed at $version_dir"
        _espvm_info "Use --force to reinstall tools"; return 0
    fi

    _espvm_info "Installing $sdk_name $version..."
    if [[ "$sdk" == "matter" ]]; then
        _espvm_install_matter "$version" "$version_dir" || return 1
    else
        _espvm_install_idf "$version" "$version_dir" || return 1
    fi
    _espvm_maybe_install "$version_dir" "$version" "$sdk" || return 1
    _espvm_ok "$sdk_name $version installed successfully"
    _espvm_info "Run 'espvm $sdk use $version' to activate it"
    return 0
}

_espvm_install_idf() {
    local version="$1" version_dir="$2"
    local bare_dir="$(_espvm_get_bare_dir "idf")" sdk_dir="$(dirname "$version_dir")"
    _espvm_init_bare "idf" || return 1

    _espvm_info "Fetching $version..."
    if ! git -C "$bare_dir" fetch origin --no-tags tag -- "$version" 2>/dev/null; then
        _espvm_info "Not a tag, trying as branch..."
        git -C "$bare_dir" fetch origin -- "$version" || { _espvm_error "Error: Failed to fetch $version"; return 1; }
    fi

    _espvm_verify_signed_tag "$bare_dir" "$version" || return 1

    _espvm_info "Creating worktree for $version..."
    mkdir -p "$sdk_dir"
    git -C "$bare_dir" worktree prune 2>/dev/null
    if ! git -C "$bare_dir" worktree add -- "$version_dir" "$version" 2>/dev/null; then
        _espvm_warn "Cleaning up stale worktree reference..."
        git -C "$bare_dir" worktree remove "$version_dir" --force 2>/dev/null
        git -C "$bare_dir" worktree prune 2>/dev/null
        git -C "$bare_dir" worktree add -- "$version_dir" "$version" || { _espvm_error "Error: Failed to create worktree"; return 1; }
    fi

    _espvm_info "Initializing submodules..."
    git -C "$version_dir" submodule update --init --recursive --jobs 8 --depth 1 || \
        { _espvm_error "Error: Failed to initialize submodules"; return 1; }
}

_espvm_install_matter() {
    local version="$1" version_dir="$2"
    local sdk_dir="$(dirname "$version_dir")" repo_url="$(_espvm_get_repo_url "matter")"
    _espvm_check_sdk_deps "matter" || return 1
    mkdir -p "$sdk_dir"

    _espvm_warn_insecure_url "$repo_url"

    _espvm_info "Cloning $version..."
    git clone --depth 1 --branch "$version" -- "$repo_url" "$version_dir" 2>/dev/null || \
        { _espvm_error "Error: Failed to clone $version"; return 1; }

    _espvm_verify_signed_tag "$version_dir" "$version" || \
        { _espvm_safe_rm_rf "$version_dir"; return 1; }

    _espvm_info "Initializing submodules..."
    git -C "$version_dir" submodule update --init --depth 1 || {
        _espvm_error "Error: Failed to initialize submodules"; _espvm_safe_rm_rf "$version_dir"; return 1
    }

    local chip_dir="$version_dir/connectedhomeip/connectedhomeip"
    if [[ -f "$chip_dir/scripts/checkout_submodules.py" ]]; then
        _espvm_info "Checking out CHIP submodules for esp32 linux..."
        (cd "$chip_dir" && _espvm_run_python_script "$chip_dir/scripts/checkout_submodules.py" --platform esp32 linux --shallow) || {
            _espvm_error "Error: Failed to checkout CHIP submodules"; _espvm_safe_rm_rf "$version_dir"; return 1
        }
    fi
}

# ── Use / Activate ──

_espvm_fix_and_retry() {
    local version_dir="$1" sdk="$2" just_installed="$3"
    [[ $just_installed -eq 1 ]] && return 1
    _espvm_confirm "Run install.sh to fix?" || return 1
    _espvm_run_install "$version_dir" "$sdk"
}

_espvm_use() {
    local sdk="$1" version="$2"; shift 2 2>/dev/null || true
    while [[ $# -gt 0 ]]; do
        case "$1" in --verbose|-v) _ESPVM_VERBOSE=1; shift ;; *) shift ;; esac
    done

    [[ -z "$version" ]] && { _espvm_error "Usage: espvm $sdk use <version> [-v]"; return 1; }
    local sdk_name="${_ESPVM_SDKS[$sdk]}"
    version="$(_espvm_resolve_version "$version")" || return 1
    _espvm_enforce_secure_git
    local encoded_version="$(_espvm_encode_version "$version")"
    local sdk_dir="$(_espvm_get_sdk_dir "$sdk")"
    local version_dir="$sdk_dir/$encoded_version"
    local current_file="$(_espvm_get_current_file "$sdk")"

    local just_installed=0
    if [[ ! -d "$version_dir" ]]; then
        _espvm_warn "$sdk_name $version is not installed"
        _espvm_confirm "Install it now?" || return 1
        _espvm_install "$sdk" "$version" || return 1
        just_installed=1
    fi

    _espvm_check_sdk_deps "$sdk" || return 1
    [[ ! -f "$version_dir/export.sh" ]] && { _espvm_error "Error: export.sh not found in $version_dir"; return 1; }

    local bare_dir="$(_espvm_get_bare_dir "$sdk")"
    [[ -d "$bare_dir" ]] && git -C "$bare_dir" worktree repair "$version_dir" 2>/dev/null

    _espvm_clear_sdk_env "$sdk"
    _espvm_info_n "Activating $sdk_name $version... "

    if ! _espvm_source_quiet "$version_dir/export.sh" "$sdk"; then
        _espvm_error "failed"
        _espvm_fix_and_retry "$version_dir" "$sdk" "$just_installed" || return 1
        _espvm_info_n "Retrying activation... "
        if _espvm_source_quiet "$version_dir/export.sh" "$sdk"; then
            _espvm_ok "done"
        else
            _espvm_error "failed"; return 1
        fi
    elif ! _espvm_verify_activation "$sdk" "$version_dir"; then
        _espvm_error "failed"
        _espvm_fix_and_retry "$version_dir" "$sdk" "$just_installed" || return 1
        _espvm_info_n "Retrying activation... "
        if _espvm_source_quiet "$version_dir/export.sh" "$sdk" && _espvm_verify_activation "$sdk" "$version_dir"; then
            _espvm_ok "done"
        else
            _espvm_error "failed"; return 1
        fi
    else
        _espvm_ok "done"
    fi

    mkdir -p "$(dirname "$current_file")"
    echo "$encoded_version" > "$current_file"
    _espvm_ok "Now using $sdk_name $version"
}

_espvm_verify_activation() {
    local sdk="$1" version_dir="$2"
    local active_path="$(_espvm_get_active_path "$sdk")"
    [[ "$active_path" == "$version_dir" ]] || return 1
    [[ "$sdk" == "idf" ]] && ! command -v idf.py &>/dev/null && return 1
    return 0
}

# ── Remove ──

_espvm_remove() {
    local sdk="$1" version="$2"
    [[ -z "$version" ]] && { _espvm_error "Usage: espvm $sdk remove <version>"; return 1; }
    local sdk_name="${_ESPVM_SDKS[$sdk]}"
    version="$(_espvm_resolve_version "$version")" || return 1
    local encoded_version="$(_espvm_encode_version "$version")"
    local version_dir="$(_espvm_get_sdk_dir "$sdk")/$encoded_version"
    local current_file="$(_espvm_get_current_file "$sdk")"

    [[ ! -d "$version_dir" ]] && { _espvm_error "Error: $sdk_name $version is not installed"; return 1; }
    local current=""
    [[ -f "$current_file" ]] && current="$(cat "$current_file")"
    [[ "$encoded_version" == "$current" ]] && _espvm_warn "Warning: $version is currently active"

    _espvm_info "Removing $sdk_name $version..."
    if _espvm_uses_worktree "$sdk"; then
        local bare_dir="$(_espvm_get_bare_dir "$sdk")"
        _espvm_ensure_bare "$sdk"
        git -C "$bare_dir" worktree remove "$version_dir" --force 2>/dev/null || _espvm_safe_rm_rf "$version_dir"
        git -C "$bare_dir" worktree prune 2>/dev/null
    else
        _espvm_safe_rm_rf "$version_dir"
    fi
    [[ "$encoded_version" == "$current" ]] && rm -f "$current_file"
    _espvm_ok "$sdk_name $version removed"
}

# ── Update ──

_espvm_update() {
    local sdk="$1" version="$2"
    [[ -z "$version" ]] && { _espvm_error "Usage: espvm $sdk update <version>"; return 1; }
    local sdk_name="${_ESPVM_SDKS[$sdk]}"
    version="$(_espvm_resolve_version "$version")" || return 1
    local encoded_version="$(_espvm_encode_version "$version")"
    local version_dir="$(_espvm_get_sdk_dir "$sdk")/$encoded_version"

    [[ ! -d "$version_dir" ]] && { _espvm_error "Error: $sdk_name $version is not installed"; return 1; }
    _espvm_info "Updating $sdk_name $version..."

    if _espvm_uses_worktree "$sdk"; then
        local bare_dir="$(_espvm_get_bare_dir "$sdk")"
        _espvm_ensure_bare "$sdk" || return 1
        git -C "$bare_dir" fetch origin --force tag -- "$version" 2>/dev/null || \
            git -C "$bare_dir" fetch origin --force -- "$version" || \
            { _espvm_error "Error: Failed to fetch updates"; return 1; }
        git -C "$version_dir" checkout -- "$version"
        git -C "$version_dir" reset --hard "$version"
        _espvm_info "Updating submodules..."
        git -C "$version_dir" submodule update --init --recursive || \
            { _espvm_error "Error: Failed to update submodules"; return 1; }
    else
        git -C "$version_dir" fetch --depth 1 origin --force tag -- "$version" 2>/dev/null || \
            git -C "$version_dir" fetch --depth 1 origin --force -- "$version" || \
            { _espvm_error "Error: Failed to fetch updates"; return 1; }
        git -C "$version_dir" checkout -- "$version"
        git -C "$version_dir" reset --hard "$version"
        _espvm_info "Updating submodules..."
        git -C "$version_dir" submodule update --init --depth 1 || \
            { _espvm_error "Error: Failed to update submodules"; return 1; }
        local chip_dir="$version_dir/connectedhomeip/connectedhomeip"
        if [[ -f "$chip_dir/scripts/checkout_submodules.py" ]]; then
            _espvm_info "Updating CHIP submodules..."
            (cd "$chip_dir" && _espvm_run_python_script "$chip_dir/scripts/checkout_submodules.py" --platform esp32 linux --shallow) || \
                { _espvm_error "Error: Failed to update CHIP submodules"; return 1; }
        fi
    fi

    _espvm_maybe_install "$version_dir" "$version" "$sdk" || return 1
    _espvm_ok "$sdk_name $version updated"
}

# ── List ──

_espvm_list() {
    local sdk="$1"
    local sdk_name="${_ESPVM_SDKS[$sdk]}" sdk_dir="$(_espvm_get_sdk_dir "$sdk")"
    [[ ! -d "$sdk_dir" ]] && { echo "No $sdk_name versions installed"; return 0; }
    echo "Installed $sdk_name versions:"
    local found=0
    for dir in "$sdk_dir"/*/; do
        [[ ! -d "$dir" ]] && continue
        local encoded_ver; encoded_ver="$(basename "$dir")"
        [[ "$encoded_ver" == .* ]] && continue
        local ver="$(_espvm_decode_version "$encoded_ver")"
        local active_path="$(_espvm_get_active_path "$sdk")"
        if [[ "$active_path" == "${dir%/}" ]]; then
            _espvm_ok "* $ver (active)"
        else
            echo "  $ver"
        fi
        found=1
    done
    [[ $found -eq 0 ]] && echo "  (none)"
}

_espvm_list_remote() {
    local sdk="$1"
    local sdk_name="${_ESPVM_SDKS[$sdk]}" repo_url="$(_espvm_get_repo_url "$sdk")"
    _espvm_warn_insecure_url "$repo_url"
    _espvm_info "Fetching available $sdk_name versions..."
    echo ""
    _espvm_info "Tags (releases):"
    local tags; tags="$(git ls-remote --tags "$repo_url" 2>/dev/null | sed 's/.*refs\/tags\///' | grep -v '\^{}' | grep '^v[0-9]' | sort -V -r | head -20)"
    [[ -n "$tags" ]] && echo "$tags" | sed 's/^/  /' || echo "  (none found)"
    echo ""
    _espvm_info "Branches:"
    local branches; branches="$(git ls-remote --heads "$repo_url" 2>/dev/null | sed 's/.*refs\/heads\///' | head -20)"
    [[ -n "$branches" ]] && echo "$branches" | sed 's/^/  /' || echo "  (none found)"
    echo ""
    _espvm_info "Use 'espvm $sdk install <version>' to install a specific version"
}

_espvm_current() {
    local sdk="$1"
    local sdk_name="${_ESPVM_SDKS[$sdk]}" current_file="$(_espvm_get_current_file "$sdk")"
    if [[ -f "$current_file" ]]; then
        local current="$(_espvm_decode_version "$(cat "$current_file")")"
        echo "Current $sdk_name version: $current"
        local active_path="$(_espvm_get_active_path "$sdk")"
        [[ -n "$active_path" ]] && echo "${_ESPVM_SDK_ENV_VAR[$sdk]}: $active_path"
    else
        echo "No $sdk_name version currently active"
        _espvm_info "Run 'espvm $sdk use <version>' to activate a version"
    fi
}

_espvm_status() {
    echo "ESP-IDF:"
    [[ -n "$IDF_PATH" ]] && _espvm_ok "  $(basename "$IDF_PATH") (active)" || echo "  (not active)"
    echo "ESP-Matter:"
    [[ -n "$ESP_MATTER_PATH" ]] && _espvm_ok "  $(basename "$ESP_MATTER_PATH") (active)" || echo "  (not active)"
}

# ── Config ──

espvm_config() {
    local action="$1" key="$2" value="$3"
    _espvm_load_config
    if [[ -z "$action" || "$action" == "show" ]]; then
        echo "espvm configuration:"
        echo ""
        echo "Config file: $ESPVM_CONFIG_FILE"
        echo ""
        echo "Settings:"
        echo "  ESPVM_WORKTREE_DIR: ${ESPVM_WORKTREE_DIR:-<not set>}"
        echo "  ESPVM_USE_SSH: ${ESPVM_USE_SSH:-auto}"
        echo ""
        echo "Bare repositories:"
        for sdk in "${!_ESPVM_SDKS[@]}"; do
            local bare_dir="$(_espvm_get_bare_dir "$sdk")"
            [[ -d "$bare_dir" ]] && echo "  ${_ESPVM_SDKS[$sdk]}: $bare_dir"
        done
        return 0
    fi
    if [[ "$action" == "set" ]]; then
        case "$key" in
            worktree-dir|worktree_dir|ESPVM_WORKTREE_DIR)
                [[ -z "$value" ]] && { _espvm_error "Usage: espvm config set worktree-dir <path>"; return 1; }
                _espvm_validate_config_value "$value" || return 1
                value="${value/#\~/$HOME}"
                [[ "$value" == /* ]] || value="$(cd "$value" 2>/dev/null && pwd -P)" || { _espvm_error "Error: Invalid path: $value"; return 1; }
                if _espvm_is_system_path "$value"; then
                    { _espvm_error "Error: Cannot set worktree-dir to system path: $value"; return 1; }
                fi
                ESPVM_WORKTREE_DIR="$value"; _espvm_save_config
                _espvm_ok "worktree-dir set to: $ESPVM_WORKTREE_DIR" ;;
            use-ssh|use_ssh|ESPVM_USE_SSH)
                [[ ! "$value" =~ ^(auto|yes|no)$ ]] && { _espvm_error "Usage: espvm config set use-ssh <auto|yes|no>"; return 1; }
                ESPVM_USE_SSH="$value"; _espvm_save_config
                _espvm_ok "use-ssh set to: $ESPVM_USE_SSH" ;;
            *) _espvm_error "Unknown config key: $key. Available keys: worktree-dir, use-ssh"; return 1 ;;
        esac
        return 0
    fi
    if [[ "$action" == "reset" ]]; then
        rm -f "$ESPVM_CONFIG_FILE"; _espvm_ok "Configuration reset"; return 0
    fi
    _espvm_error "Unknown config action: $action. Usage: espvm config [show|set <key> <value>|reset]"
    return 1
}

# ── Help ──

_espvm_sdk_help() {
    local sdk="$1"
    local sdk_name="${_ESPVM_SDKS[$sdk]}"
    cat << EOF
Usage: espvm $sdk <command> [args]

Commands:
  install <ver> [-v] [--force]   Install version (tag or branch)
  use <ver> [-v]                 Activate version in current shell
  off                            Deactivate in current shell
  list                           List installed versions
  list-remote                    List available tags and branches
  remove <ver>                   Remove installed version
  update <ver>                   Update version to latest
  current                        Show active version
  repair                         Fix broken worktree links

Examples:
  espvm $sdk install 5.4.1
  espvm $sdk use 5.4.1
  espvm $sdk list-remote
EOF
}

espvm_help() {
    cat << 'EOF'
espvm - ESP SDK Version Manager

Usage:
  espvm [-i|-m] <version>     Activate version (install if needed)
  espvm [-i|-m] <command>     Run command

SDK Flags:
  -i    ESP-IDF (default)
  -m    ESP-Matter

Commands:
  i <ver>         Install version
  use <ver>       Activate version
  off             Deactivate
  ls              List installed
  remote          List available
  rm <ver>        Remove version
  update <ver>    Update installed version
  current         Show active version
  repair          Fix broken worktree links
  status          Show active versions
  config          Configuration

Legacy:
  espvm idf <cmd>     Full SDK name still works
  espvm matter <cmd>

Examples:
  espvm 5.4.1         Activate IDF 5.4.1
  espvm i 5.5         Install IDF 5.5
  espvm -m i 1.0      Install Matter 1.0
  espvm -m use 1.0    Activate Matter 1.0
  espvm off           Deactivate IDF
  espvm -m off        Deactivate Matter
  espvm ls            List IDF versions
  espvm -m ls         List Matter versions
  espvm status        Show what's active
EOF
}

# ── Command Dispatch ──

_espvm_sdk_command() {
    local sdk="$1" cmd="$2"; shift 2
    case "$cmd" in
        install)     _espvm_install "$sdk" "$@" ;;
        use)         _espvm_use "$sdk" "$@" ;;
        off|deactivate) _espvm_off "$sdk" ;;
        list)        _espvm_list "$sdk" ;;
        list-remote) _espvm_list_remote "$sdk" ;;
        remove)      _espvm_remove "$sdk" "$@" ;;
        update)      _espvm_update "$sdk" "$@" ;;
        current)     _espvm_current "$sdk" ;;
        repair)
            if ! _espvm_uses_worktree "$sdk"; then
                _espvm_warn "Repair not needed for ${_ESPVM_SDKS[$sdk]} (uses regular clones)"; return 0
            fi
            _espvm_ensure_bare "$sdk" || return 1
            _espvm_repair_worktrees "$sdk"
            _espvm_ok "Worktree links repaired" ;;
        help|--help|-h|"") _espvm_sdk_help "$sdk" ;;
        *) _espvm_error "Unknown command: $cmd"; _espvm_sdk_help "$sdk"; return 1 ;;
    esac
}

# ── Entry Point ──

espvm() {
    local sdk="idf"
    case "$1" in
        -i) sdk="idf"; shift ;;
        -m) sdk="matter"; shift ;;
    esac

    local cmd="$1"; shift 2>/dev/null || true

    # Bare version args (v5.4.1, 5.4.1, release/v5.0) route to 'use'
    if [[ "$cmd" =~ ^v?[0-9] ]] || [[ "$cmd" =~ ^release[/-] ]]; then
        _espvm_use "$sdk" "$cmd" "$@"; return
    fi

    case "$cmd" in
        idf|matter)       _espvm_sdk_command "$cmd" "$@" ;;
        i|install)        _espvm_sdk_command "$sdk" "install" "$@" ;;
        use)              _espvm_sdk_command "$sdk" "use" "$@" ;;
        off|deactivate)   _espvm_off "$sdk" ;;
        ls|list)          _espvm_list "$sdk" ;;
        remote|list-remote) _espvm_list_remote "$sdk" ;;
        rm|remove)        _espvm_remove "$sdk" "$@" ;;
        update)           _espvm_update "$sdk" "$@" ;;
        current)          _espvm_current "$sdk" ;;
        repair)           _espvm_sdk_command "$sdk" "repair" ;;
        status)           _espvm_status ;;
        config)            espvm_config "$@" ;;
        help|--help|-h|"") espvm_help ;;
        *) _espvm_error "Unknown: $cmd"; espvm_help; return 1 ;;
    esac
}

# ── Completions ──

_espvm_get_installed_versions() {
    local s="$1"
    _espvm_load_config 2>/dev/null
    local sname="${_ESPVM_SDKS[$s]}"
    local sdir="${ESPVM_WORKTREE_DIR:-$HOME/.espressif/versions}/$sname"
    if [[ -d "$sdir" ]]; then
        for d in "$sdir"/*/; do
            [[ -d "$d" ]] || continue
            local v; v="$(basename "$d")"
            [[ "$v" == .* ]] && continue
            echo "$v"
        done
    fi
}

_espvm_complete_versions() {
    local sdk="$1" cur="$2"
    COMPREPLY+=($(compgen -W "$(_espvm_get_installed_versions "$sdk")" -- "$cur"))
}

_espvm_compgen_path() {
    local cur="$1" prefix="${2:-}"
    local expanded="${cur#"$prefix"}"
    expanded="${expanded/#\~/$HOME}"
    local d
    while IFS= read -r d; do
        [[ -n "$d" ]] && COMPREPLY+=("$prefix$d")
    done < <(compgen -d -- "$expanded" 2>/dev/null)
}

_espvm_complete_install_opts() {
    local cur="$1" prev="$2"
    if [[ "$cur" == --path=* ]]; then
        _espvm_compgen_path "$cur" "--path="
    elif [[ "$prev" == "--path" ]]; then
        _espvm_compgen_path "$cur"
    else
        COMPREPLY+=($(compgen -W "-v --verbose -f --force --path" -- "$cur"))
    fi
}

_espvm_completions() {
    COMPREPLY=()
    local cur="${COMP_WORDS[COMP_CWORD]}" prev="${COMP_WORDS[COMP_CWORD-1]}"
    local cword=$COMP_CWORD
    local -a words=("${COMP_WORDS[@]}")

    local sdk="idf" cmd_index=1
    for ((i=1; i<cword; i++)); do
        case "${words[i]}" in
            -i) sdk="idf"; ((cmd_index++)) ;;
            -m) sdk="matter"; ((cmd_index++)) ;;
        esac
    done

    local cmd=""
    [[ $cword -gt $cmd_index ]] && cmd="${words[cmd_index]}"
    local commands="i install use off ls list remote list-remote rm remove update current repair status config help idf matter"
    local sdk_flags="-i -m"

    if [[ $cword -eq 1 ]]; then
        COMPREPLY=($(compgen -W "$sdk_flags $commands" -- "$cur")); return
    fi
    if [[ $cword -eq 2 && ("${words[1]}" == "-i" || "${words[1]}" == "-m") ]]; then
        COMPREPLY=($(compgen -W "$commands" -- "$cur")); return
    fi

    case "$cmd" in
        use|rm|remove|update)
            _espvm_complete_versions "$sdk" "$cur" ;;
        i|install)
            _espvm_complete_install_opts "$cur" "$prev" ;;
        config)
            case "$prev" in
                config)  COMPREPLY+=($(compgen -W "show set reset" -- "$cur")) ;;
                set)     COMPREPLY+=($(compgen -W "worktree-dir use-ssh" -- "$cur")) ;;
                use-ssh) COMPREPLY+=($(compgen -W "auto yes no" -- "$cur")) ;;
                worktree-dir|worktree_dir|ESPVM_WORKTREE_DIR) _espvm_compgen_path "$cur" ;;
            esac ;;
        idf|matter)
            if [[ $prev == "idf" || $prev == "matter" ]]; then
                COMPREPLY+=($(compgen -W "install use off list list-remote remove update current repair help" -- "$cur"))
            else
                local subcmd="${words[cmd_index+1]}"
                case "$subcmd" in
                    use|rm|remove|update)
                        _espvm_complete_versions "$cmd" "$cur" ;;
                    install)
                        _espvm_complete_install_opts "$cur" "$prev" ;;
                esac
            fi ;;
    esac
}

_espvm_register_completion() {
    if command -v complete >/dev/null 2>&1; then
        complete -F _espvm_completions espvm 2>/dev/null; return
    fi
    if [[ -n "${ZSH_VERSION:-}" ]]; then
        autoload -Uz bashcompinit 2>/dev/null || return
        bashcompinit 2>/dev/null || return
        complete -F _espvm_completions espvm 2>/dev/null
    fi
}
_espvm_register_completion

# Allow direct execution as fallback (sourcing is the primary usage)
[[ "${BASH_SOURCE[0]}" == "${0}" ]] && espvm "$@"